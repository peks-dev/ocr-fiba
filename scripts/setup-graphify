#!/bin/sh
set -eu

EXPECTED_VERSION="0.9.26"
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VENV="$REPO_ROOT/.graphify-venv"
PYTHON_BIN=${PYTHON_BIN:-python3}

"$PYTHON_BIN" -m venv "$VENV"
"$VENV/bin/python" -m pip install \
    --disable-pip-version-check \
    --require-hashes \
    -r "$REPO_ROOT/requirements-graphify.lock"

ACTUAL_VERSION=$($VENV/bin/graphify --version | awk '{print $2}')
if [ "$ACTUAL_VERSION" != "$EXPECTED_VERSION" ]; then
    echo "Expected graphify $EXPECTED_VERSION, found $ACTUAL_VERSION" >&2
    exit 1
fi

echo "Graphify $ACTUAL_VERSION installed in $VENV"
