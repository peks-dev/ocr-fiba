# Core OCR providers (fill locally)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
INTERFAZE_API_KEY=
GLM_API_KEY=
DOCSTRANGE_API_KEY=
QUBRID_API_KEY=

# Local API auth fallback for non-Supabase development
OCR_ENGINE_API_KEY=dev-local-token
OCR_ENV=development
OCR_RUNS_DIR=runs
OCR_MAX_UPLOAD_MB=20
OCR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Foundation / Web Minimal local validation
SUPABASE_URL=https://cgcejoqsmouieijkkogw.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# Public deployment hardening (defaults shown are the production defaults)
# OCR_ALLOW_PATH_INPUT=false          # POST /v1/runs {image_path}; dev default true
# MCP_ALLOW_PATH_INPUT=false          # MCP submit_scoresheet_from_path tool; dev default true
# OCR_RATE_LIMIT_PER_MINUTE=3         # run creations per token per minute (0 = off; dev default 0)
# OCR_RATE_LIMIT_PER_DAY=50           # run creations per token per rolling 24h (0 = off; dev default 0)
# OCR_RATE_LIMIT_STATE_FILE=          # optional JSON file to persist quota across restarts
# OCR_DEFAULT_EXTRACTOR_PROVIDER=openrouter      # server-side default when clients don't set one
# OCR_DEFAULT_EXTRACTOR_MODEL=google/gemini-4-carbon
# OCR_DEFAULT_EXTRACTOR_REASONING={"effort":"low","exclude":true}
# OCR_STALE_RUN_SECONDS=900           # reconcile crashed/stalled queued/running runs (0 = off)
